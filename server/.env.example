PORT=5000
# Optional: Live PostgreSQL connection string. If omitted, built-in in-memory PostgreSQL emulator is used.
DATABASE_URL=postgresql://user:password@localhost:5432/potentpolicy

JWT_SECRET=your_jwt_secret_key_here
PARTICIPATION_SECRET=your_participation_secret_key_here

# email mode: 'capture' (stores in dev_emails table viewable at /dev/outbox) or 'smtp' (live mailer)
EMAIL_MODE=capture

# SMTP settings (required only when EMAIL_MODE=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=password
EMAIL_FROM="PotentPolicy" <noreply@potentpolicy.com>

# Business flags
ALLOW_PUBLIC_EMAIL_DOMAINS=true
SHOW_COMMENTER_IDENTITY=false
NODE_ENV=development
